<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Pure Wolf Movement — Be Original. Move Different.</title>

<meta name="description" content="Pure Wolf Movement — bold independent streetwear inspired by wolves, freedom, strength and individuality.">

<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;500;600;700;800;900&display=swap');

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #050507;
  color: #ffffff;
  font-family: Montserrat, Arial, sans-serif;
}

a {
  text-decoration: none;
  color: inherit;
}

:root {
  --purple: #a855f7;
  --purple-dark: #6d28d9;
  --line: #30243d;
  --muted: #aaa3b3;
}

.container {
  width: min(1180px, 92%);
  margin: auto;
}

/* HEADER */

header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(4,4,7,.78);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(168,85,247,.25);
}

.nav {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-family: "Bebas Neue";
  font-size: 1.8rem;
  letter-spacing: 2px;
}

.logo span {
  color: #b66cff;
}

nav {
  display: flex;
  gap: 26px;
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: 1px;
}

nav a:hover {
  color: #c084fc;
}

.cart {
  border: 1px solid #594568;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
}

/* HERO */

.hero {
  min-height: 100vh;
  padding-top: 72px;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;

  background:
    radial-gradient(circle at 20% 45%, rgba(124,58,237,.30), transparent 32%),
    radial-gradient(circle at 82% 32%, rgba(168,85,247,.22), transparent 27%),
    linear-gradient(120deg,#050507,#12091a 52%,#050507);
}

.hero:before {
  content: "";
  position: absolute;
  inset: 0;

  background:
    repeating-linear-gradient(
      125deg,
      transparent 0 80px,
      rgba(168,85,247,.035) 81px 82px
    );
}

.hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 70px 0;
}

.kicker {
  font-size: .72rem;
  font-weight: 900;
  letter-spacing: 5px;
  color: #c084fc;
  text-transform: uppercase;
}

h1 {
  font-family: "Bebas Neue";
  font-size: clamp(5rem,14vw,12rem);
  line-height: .72;
  letter-spacing: 5px;
  text-shadow: 0 0 35px rgba(168,85,247,.35);
  margin: 18px 0;
}

h1 span {
  color: #a855f7;
}

.tag {
  font-size: clamp(.8rem,2vw,1.1rem);
  letter-spacing: 3px;
  font-weight: 800;
}

.tag b {
  color: #c084fc;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.btn {
  display: inline-flex;
  padding: 15px 26px;
  border-radius: 3px;
  background: linear-gradient(135deg,#b55cff,#6d28d9);
  font-weight: 900;
  font-size: .78rem;
  letter-spacing: 1px;
  border: 1px solid #cf9cff;
  box-shadow: 0 0 25px rgba(124,58,237,.3);
}

.btn.alt {
  background: transparent;
  box-shadow: none;
  border-color: #65536f;
}

.hero-note {
  margin: 42px auto 0;
  color: #81798a;
  font-size: .7rem;
  letter-spacing: 2px;
}

/* SECTIONS */

section {
  padding: 92px 0;
}

.section-title {
  text-align: center;
  margin-bottom: 40px;
}

.section-title .kicker {
  margin-bottom: 8px;
}

h2 {
  font-family: "Bebas Neue";
  font-size: 3.4rem;
  letter-spacing: 2px;
}

.section-title p {
  color: var(--muted);
  max-width: 650px;
  margin: 8px auto;
}

/* PRODUCTS */

.products {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 25px;
}

.card {
  background: linear-gradient(145deg,#111015,#09090c);
  border: 1px solid #30243d;
  position: relative;
  overflow: hidden;
  transition: .3s;
}

.card:hover {
  transform: translateY(-6px);
  border-color: rgba(168,85,247,.7);
  box-shadow: 0 20px 50px rgba(0,0,0,.45);
}

.card img {
  width: 100%;
  display: block;
  aspect-ratio: 1.25;
  object-fit: cover;
  background: #0b0b0f;
}

.card-body {
  padding: 25px;
}

.card h3 {
  font-size: 1.15rem;
}

.price {
  color: #c084fc;
  font-weight: 900;
  margin: 6px 0 18px;
}

.pill {
  display: inline-block;
  border: 1px solid #543b64;
  padding: 5px 9px;
  font-size: .6rem;
  letter-spacing: 1px;
  color: #caa8dc;
  margin-bottom: 12px;
}

/* FEATURES */

.features {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.feature {
  padding: 28px 18px;
  text-align: center;
  border-right: 1px solid var(--line);
}

.feature:last-child {
  border: 0;
}

.icon {
  font-size: 1.8rem;
  color: #c084fc;
  margin-bottom: 9px;
}

.feature h3 {
  font-size: .8rem;
}

.feature p {
  font-size: .68rem;
  color: var(--muted);
  margin-top: 5px;
}

/* STORY */

.story {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
  align-items: stretch;
}

.panel {
  border: 1px solid var(--line);
  padding: 36px;
  background: linear-gradient(145deg,#100d14,#08080a);
}

.panel h3 {
  font-family: "Bebas Neue";
  font-size: 2.3rem;
  letter-spacing: 1px;
}

.panel p {
  color: var(--muted);
  margin-top: 10px;
  line-height: 1.9;
}

/* RETAIL */

.retail {
  background:
    radial-gradient(circle at 80% 30%,rgba(168,85,247,.22),transparent 35%),
    #100b15;

  border: 1px solid #503361;
  padding: 55px;
  text-align: center;
}

.retail h2 {
  font-size: 3.5rem;
}

.retail p {
  color: #b9b0c0;
  max-width: 720px;
  margin: 10px auto 25px;
}

/* CONTACT */

.contact {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

.contact .panel a {
  color: #c084fc;
}

/* FOOTER */

footer {
  border-top: 1px solid var(--line);
  padding: 35px 0;
  color: #81798a;
  font-size: .7rem;
}

.foot {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

/* MOBILE */

@media(max-width:800px) {

  nav {
    display: none;
  }

  .products,
  .story,
  .contact {
    grid-template-columns: 1fr;
  }

  .features {
    grid-template-columns: 1fr 1fr;
  }

  .feature:nth-child(2) {
    border-right: 0;
  }

  .feature:nth-child(-n+2) {
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    padding: 45px 0;
  }

  h1 {
    font-size: 5.5rem;
  }

  .retail {
    padding: 35px 20px;
  }

  .retail h2 {
    font-size: 2.7rem;
  }
}
</style>
</head>

<body>

